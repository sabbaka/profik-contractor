GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_API_URL=
# Sentry crash reporting. Leave empty in dev — the SDK stays disabled.
# Get the DSN from sentry.io → project settings → Client Keys.
EXPO_PUBLIC_SENTRY_DSN=
# PostHog analytics (EU cloud). Leave empty in dev — src/utils/analytics.ts
# no-ops without a key. Shares one project with profik_client; ask a
# teammate for the key rather than creating a second project.
EXPO_PUBLIC_POSTHOG_KEY=
# RevenueCat public SDK key of the App Store app (starts with appl_). iOS sells
# credits through In-App Purchase with it; without one the Balance screen on
# iOS says buying is unavailable and never falls back to Stripe. For builds,
# set it as an EAS environment variable. Android does not use it.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
